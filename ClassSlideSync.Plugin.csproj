<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required for a plugin loaded into a host process: this is what emits the
             .runtimeconfig.json that the ClassIsland loader (and every plugin already installed
             under data\Plugins) ships, and makes the SDK resolve dependencies from the host. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Must match the installed ClassIsland build (2.1.0.1 here): compiling against a newer
             SDK than the host is the one combination that can reference APIs the host lacks. -->
        <ClassIslandPluginSdkVersion>2.1.0.1</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- The one-click .cipx packaging zips the whole output folder, so keep debug symbols out of
             it: the release package then only holds the dll, the two json files, manifest, icon and
             README. -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- 纯页码示例课件：整个 test\ 目录随输出走，老师装完插件就能拿它试功能。
             用 Include（不是 Update）：test\ 是子目录，默认的 None 通配并不包含它的内容。
             CreateCipx 是 ZipDirectory 整个输出目录，所以这个子目录会一起打进 .cipx。 -->
        <None Include="test\纯页码课件.pptx">
            <!-- 必须给 Link：不是写在项目根下的文件，CopyToOutputDirectory 默认会把它拍到
                 输出目录根上，运行时按 test\纯页码课件.pptx 就找不到了。 -->
            <Link>test\纯页码课件.pptx</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- 新手引导的教程 JSON（ClassIsland 原生 Tutorial 格式），运行时从程序集里读。 -->
        <EmbeddedResource Include="Assets\Tutorials\getStarted.json" />
    </ItemGroup>

</Project>
