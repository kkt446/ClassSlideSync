<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- net8.0, NOT net8.0-windows：同一个 dll 要在 Windows 与 Linux 两端都能被 ClassIsland
             加载（宿主不按 TFM/OS 过滤插件）。所有 Windows 专属能力都靠运行时
             OperatingSystem.IsWindows() 判断，绝不用 #if WINDOWS 编译期裁剪，否则两端就不是同一份
             二进制了。Windows 上的行为一行不变：宿主本身是 net8.0-windows，加载 net8.0 程序集完全合法。 -->
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- Required for a plugin loaded into a host process: this is what emits the
             .runtimeconfig.json that the ClassIsland loader (and every plugin already installed
             under data\Plugins) ships, and makes the SDK resolve dependencies from the host. -->
        <EnableDynamicLoading>true</EnableDynamicLoading>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Must match the installed ClassIsland build (2.1.0.1 here): compiling against a newer
             SDK than the host is the one combination that can reference APIs the host lacks. -->
        <ClassIslandPluginSdkVersion>2.1.0.1</ClassIslandPluginSdkVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <!-- The one-click .cipx packaging zips the whole output folder, so keep debug symbols out of
             it: the release package then only holds the dll, the two json files, manifest, icon and
             README. -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClassIsland.PluginSdk" Version="$(ClassIslandPluginSdkVersion)">
            <ExcludeAssets>runtime; native</ExcludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Update="manifest.yml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="README.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="icon.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- 纯页码示例课件：整个 test\ 目录随输出走，老师装完插件就能拿它试功能。
             用 Include（不是 Update）：test\ 是子目录，默认的 None 通配并不包含它的内容。
             CreateCipx 是 ZipDirectory 整个输出目录，所以这个子目录会一起打进 .cipx。 -->
        <None Include="test\纯页码课件.pptx">
            <!-- 必须给 Link：不是写在项目根下的文件，CopyToOutputDirectory 默认会把它拍到
                 输出目录根上，运行时按 test\纯页码课件.pptx 就找不到了。 -->
            <Link>test\纯页码课件.pptx</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <!-- 新手引导的教程 JSON（ClassIsland 原生 Tutorial 格式），运行时从程序集里读。 -->
        <EmbeddedResource Include="Assets\Tutorials\getStarted.json" />
    </ItemGroup>

    <!-- ===== 横幅 helper（Tools\ToastHelper）=====
         helper 是一个独立的小 exe：弹 Windows 操作中心横幅需要 WinRT 投影
         （Windows.UI.Notifications + Windows.Data.Xml.Dom，net8.0-windows10.0.19041.0 起才有），
         而插件的目标框架被 ClassIsland 的动态加载钉死在 net8.0-windows，不能改，也不能给插件加 NuGet。
         所以它自己单独编译，主工程构建时顺带构建它、再把整个输出目录拷到 $(OutDir)ToastHelper\。
         .cipx 是「把整个输出目录打 zip」，因此插件包天然带上它，老师装上插件就自带横幅能力。 -->
    <PropertyGroup>
        <ToastHelperProject>$(MSBuildProjectDirectory)\Tools\ToastHelper\ToastHelper.csproj</ToastHelperProject>
        <ToastHelperOut>$(MSBuildProjectDirectory)\Tools\ToastHelper\bin\$(Configuration)\net8.0-windows10.0.19041.0</ToastHelperOut>
    </PropertyGroup>

    <ItemGroup>
        <!-- 增量判断用：helper 的源码/工程文件变了才重新编它。 -->
        <ToastHelperSource Include="$(MSBuildProjectDirectory)\Tools\ToastHelper\*.cs;$(ToastHelperProject)" />
    </ItemGroup>

    <!-- 只在 Windows 上构建/拷贝 helper：helper 是 net8.0-windows10.0.19041.0 的 WinRT exe，
         Linux 的 dotnet 编不出来。Linux 上这两个 target 整体跳过，输出目录里就没有 ToastHelper\，
         Core\ToastNotifier.cs 找不到 helper 会自己退回托盘气泡/静默，Pack-Cipx 也照常能打包。 -->
    <Target Name="BuildToastHelper"
            BeforeTargets="Build"
            Condition="'$(OS)' == 'Windows_NT' And Exists('$(ToastHelperProject)')"
            Inputs="@(ToastHelperSource)"
            Outputs="$(OutDir)ToastHelper\ToastHelper.exe">
        <!-- 用 Exec 起一个子 dotnet，而不是 MSBuild 任务：MSBuild 任务会把主工程的全局属性
             （Configuration/Platform/TargetFramework）带进子工程，helper 的 TFM 会被覆盖成
             net8.0-windows，WinRT 投影就编不出来了。子进程完全隔离，最干净。 -->
        <PropertyGroup>
            <_ToastDotnet>$(DOTNET_HOST_PATH)</_ToastDotnet>
            <_ToastDotnet Condition="'$(_ToastDotnet)' == ''">dotnet</_ToastDotnet>
        </PropertyGroup>
        <Exec Command="&quot;$(_ToastDotnet)&quot; build &quot;$(ToastHelperProject)&quot; -c $(Configuration) -v:m -nologo" />
    </Target>

    <Target Name="CopyToastHelper"
            AfterTargets="Build"
            BeforeTargets="CreateCipx"
            Condition="'$(OS)' == 'Windows_NT' And Exists('$(ToastHelperOut)\ToastHelper.exe')">
        <ItemGroup>
            <_ToastHelperFile Include="$(ToastHelperOut)\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_ToastHelperFile)"
              DestinationFiles="@(_ToastHelperFile->'$(OutDir)ToastHelper\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <!-- 登记成构建产物：这样 `dotnet build -t:Rebuild` 的 Clean 会顺手删掉，
             否则旧版 helper 会一直残留在输出目录里被打进下一个 .cipx。 -->
        <ItemGroup>
            <FileWrites Include="@(_ToastHelperFile->'$(OutDir)ToastHelper\%(RecursiveDir)%(Filename)%(Extension)')" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!-- tools\ToastHelper 是一个独立的小工具工程（横幅通知），它有自己的 csproj 与 obj/bin。
             主工程的默认 Compile/Avalonia 通配会把它的源码和生成文件一起吞进来，导致 CS0579 重复特性
             和 Windows.Data/UI 找不到。这里显式排除整个 tools\ 目录，主工程只保留 tools 下的脚本。 -->
        <Compile Remove="tools\**\*.cs" />
        <AvaloniaXaml Remove="tools\**\*" />
        <AvaloniaResource Remove="tools\**\*" />
        <EmbeddedResource Remove="tools\**\*" />
        <None Remove="tools\**\obj\**" />
        <None Remove="tools\**\bin\**" />

    </ItemGroup>

</Project>
